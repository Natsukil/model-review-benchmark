__pycache__/
*.py[cod]
.venv/
.env

# Downloaded benchmark sources. Keep manifests and curated selections under data/.
data/raw/*
!data/raw/.gitkeep

# Runtime caches and temporary workspaces.
data/cache/*
!data/cache/.gitkeep
data/workspaces/*
!data/workspaces/.gitkeep

# Per-run artifacts and generated summaries.
outputs/*
!outputs/.gitkeep
reports/*
!reports/.gitkeep

*.log
.pytest_cache/
*.egg-info/
